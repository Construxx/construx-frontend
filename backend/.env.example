# --- Database (Postgres). Default matches docker-compose.yml ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/construx?schema=public&connection_limit=10&pool_timeout=20"

# --- Auth: use two different long random strings ---
JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-unique-random-secret-32chars"

# --- Server ---
PORT=4000
FRONTEND_URL="http://localhost:5173,http://localhost:4173"   # exact comma-separated origins
AUTH_COOKIE_SAME_SITE="lax"             # use "none" for cross-site HTTPS deployments

# --- AI engine (optional: without a key the AI endpoints fall back to rule-based answers) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Business rules ---
PROCUREMENT_LOOKAHEAD_DAYS=14
